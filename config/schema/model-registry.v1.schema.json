{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classscribe.local/config/model-registry.v1.schema.json",
  "title": "ClassScribe model registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_revision", "facts_as_of", "sources", "models", "rankings", "history"],
  "properties": {
    "schema_version": {"const": 1},
    "registry_revision": {"type": "integer", "minimum": 1},
    "facts_as_of": {"type": "string", "format": "date"},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "uri"}},
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/model"}
    },
    "rankings": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"type": "string"}
      }
    },
    "history": {"type": "array", "items": {"type": "object"}}
  },
  "$defs": {
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "display_name", "provider", "repository", "revision", "worker", "languages",
        "tasks", "modes", "input_sample_rate", "input_channels", "input_dtype",
        "runtime_backend", "dtype", "trust_remote_code", "safe_operating_window_seconds",
        "vendor_claimed_max_seconds", "responses", "resources", "dependency_lock",
        "dependency_lock_sha256", "installation", "benchmark", "enabled", "experimental",
        "known_defects", "disable_reason"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
        "display_name": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "pattern": "^[^\\s]+/[^\\s]+$"},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "worker": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]{0,63}$"},
        "languages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "tasks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "modes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["batch", "streaming", "final_decode"]}},
        "input_sample_rate": {"const": 16000},
        "input_channels": {"const": 1},
        "input_dtype": {"const": "pcm_s16le"},
        "runtime_backend": {"type": "string", "minLength": 1},
        "dtype": {"enum": ["float32", "float16", "bfloat16", "int8", "q8_0"]},
        "trust_remote_code": {"type": "boolean"},
        "safe_operating_window_seconds": {"type": "integer", "minimum": 1, "maximum": 5400},
        "vendor_claimed_max_seconds": {"type": ["integer", "null"], "minimum": 1},
        "responses": {
          "type": "object",
          "additionalProperties": false,
          "required": ["segment_timestamps", "word_timestamps", "confidence", "logprobs", "punctuation", "speakers", "hotwords"],
          "properties": {
            "segment_timestamps": {"type": "boolean"},
            "word_timestamps": {"type": "boolean"},
            "confidence": {"type": "boolean"},
            "logprobs": {"type": "boolean"},
            "punctuation": {"type": "boolean"},
            "speakers": {"type": "boolean"},
            "hotwords": {"type": "boolean"}
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["vram_class", "estimated_vram_mb", "measured_vram_mb", "safety_margin_mb"],
          "properties": {
            "vram_class": {"enum": ["tiny", "small", "medium", "large", "too_large"]},
            "estimated_vram_mb": {"type": "integer", "minimum": 0},
            "measured_vram_mb": {"type": ["integer", "null"], "minimum": 0},
            "safety_margin_mb": {"type": "integer", "minimum": 512}
          }
        },
        "dependency_lock": {"type": "string", "pattern": "^workers/[a-z0-9_]+/uv\\.lock$"},
        "dependency_lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "installation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "artifact_sha256", "local_revision"],
          "properties": {
            "state": {"enum": ["not_installed", "installed", "unhealthy", "missing", "staged"]},
            "artifact_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
            "local_revision": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"}
          }
        },
        "benchmark": {
          "type": "object",
          "additionalProperties": false,
          "required": ["latest_run_id", "results", "source"],
          "properties": {
            "latest_run_id": {"type": ["string", "null"]},
            "results": {"type": "object"},
            "source": {"enum": ["bootstrap_public_facts", "local_gold"]}
          }
        },
        "enabled": {"type": "boolean"},
        "experimental": {"type": "boolean"},
        "known_defects": {"type": "array", "items": {"type": "string"}},
        "disable_reason": {"type": ["string", "null"]}
      }
    }
  }
}
