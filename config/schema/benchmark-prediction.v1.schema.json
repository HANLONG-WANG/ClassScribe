{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classscribe.local/schema/benchmark-prediction.v1.schema.json",
  "title": "ClassScribe benchmark prediction JSONL item",
  "type": "object",
  "required": ["item_id", "model_id", "model_revision", "text", "confidence", "provenance_coverage"],
  "properties": {
    "item_id": { "type": "string", "minLength": 1 },
    "model_id": { "type": "string", "minLength": 1 },
    "model_revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "text": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "quality_features": { "type": "array", "items": { "type": "number" } },
    "words": { "type": "array", "items": { "type": "object" } },
    "sentence_boundaries": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
    "speaker_spans": { "type": "array", "items": { "type": "object" } },
    "voiced_spans": { "type": "array", "items": { "type": "array", "minItems": 2, "maxItems": 2 } },
    "runtime_seconds": { "type": "number", "minimum": 0 },
    "load_seconds": { "type": "number", "minimum": 0 },
    "peak_vram_mb": { "type": "number", "minimum": 0 },
    "peak_ram_mb": { "type": "number", "minimum": 0 },
    "interim_latency_ms": { "type": ["number", "null"], "minimum": 0 },
    "commit_latency_ms": { "type": ["number", "null"], "minimum": 0 },
    "preemption_resume_ms": { "type": ["number", "null"], "minimum": 0 },
    "cross_window_speakers": { "type": "array", "items": { "type": "string" } },
    "provenance_coverage": { "type": "number", "minimum": 0, "maximum": 1 }
  },
  "additionalProperties": false
}
