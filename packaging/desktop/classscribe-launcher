#!/bin/sh
set -eu

url=$(/usr/libexec/classscribe-core --print-url)
systemctl --user start classscribe-core.service
attempt=0
while [ "$attempt" -lt 50 ]; do
    if curl --fail --silent --show-error --max-time 1 "$url/healthz" >/dev/null; then
        exec xdg-open "$url"
    fi
    attempt=$((attempt + 1))
    sleep 0.1
done
printf 'ClassScribe core did not become healthy at %s\n' "$url" >&2
exit 1
